# Anthropic API key for the live NOVA turn; leave empty to keep the scripted intake only.
ANTHROPIC_API_KEY=
# Model for the live NOVA turn; must accept thinking disabled (Sonnet 5, Opus 5, Haiku 4.5).
NOVA_MODEL=claude-haiku-4-5-20251001
# HMAC secret for the NOVA session pass; leave empty to derive one from ANTHROPIC_API_KEY.
NOVA_SECRET=
# Model calls per hour per instance before /api/nova answers 429 busy; default 120.
NOVA_HOURLY_CAP=
